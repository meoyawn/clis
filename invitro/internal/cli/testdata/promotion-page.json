      "cards": [
        {
          "number": 1,
          "title": "Кровь из вены сдают утром, строго натощак (длительность ночного голодания: 8–14 часов)",
          "id": "6a901f4ecf05eb612bea84ae"
        },
        {
          "number": 2,
          "title": "За день до процедуры исключить повышенные эмоциональные и физические нагрузки (спортивные тренировки), прием алкоголя",
          "id": "6a901f54cf05eb612bea84af"
        }
