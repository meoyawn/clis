      "textBlockTitle": "Биохимия крови",
      "textBlockContent": [
        {
          "blockType": "description",
          "content": {
            "root": {
              "children": [
                {
                  "children": [
                    {
                      "detail": 0,
                      "format": 0,
                      "mode": "normal",
                      "style": "",
                      "text": "Если вы хотите проверить здоровье, но не знаете, какие анализы сдать в первую очередь, то начните с биохимии!",
                      "type": "text",
                      "version": 1
                    }
                  ],
                  "direction": null,
                  "format": "justify",
                  "indent": 0,
                  "type": "paragraph",
                  "version": 1,
                  "textFormat": 0,
                  "textStyle": ""
                },
                {
                  "children": [],
                  "direction": null,
                  "format": "justify",
                  "indent": 0,
                  "type": "paragraph",
                  "version": 1,
                  "textFormat": 0,
                  "textStyle": ""
                },
                {
                  "children": [
                    {
                      "detail": 0,
                      "format": 0,
                      "mode": "normal",
                      "style": "",
                      "text": "Биохимический анализ крови показывает состояние органов и систем и помогает выявить скрытые заболевания даже до возникновения симптомов. Это информативное исследование можно пройти в любом нашем медицинском офисе.",
                      "type": "text",
                      "version": 1
                    }
                  ],
                  "direction": null,
                  "format": "justify",
                  "indent": 0,
                  "type": "paragraph",
                  "version": 1,
                  "textFormat": 0,
                  "textStyle": ""
                },
                {
                  "children": [
                    {
                      "detail": 0,
                      "format": 0,
                      "mode": "normal",
                      "style": "",
                      "text": " ",
                      "type": "text",
                      "version": 1
                    }
                  ],
                  "direction": null,
                  "format": "justify",
                  "indent": 0,
                  "type": "paragraph",
                  "version": 1,
                  "textFormat": 0,
                  "textStyle": ""
                },
                {
                  "children": [
                    {
                      "detail": 0,
                      "format": 0,
                      "mode": "normal",
                      "style": "",
                      "text": "До 30 сентября пройдите базовый и минимальный биохимический комплекс со скидкой 15%.",
                      "type": "text",
                      "version": 1
                    }
                  ],
                  "direction": null,
                  "format": "",
                  "indent": 0,
                  "type": "paragraph",
                  "version": 1,
